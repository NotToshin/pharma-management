interface DoctorRecord {
  id: string;
  docCode: string;
  name: string;
  bmdcReg: string;
  specialty: string;
  designation: string;
  institute: string;
  chamberAddress: string;
  territory: string;
  contactNumber: string;
  potentialCategory: "A+" | "A" | "B" | "C" | "Tier 1 (High Prescriber)" | "Tier 2 (Moderate)" | "Tier 3 (Potential)";
  patientVolumeDaily: number;
  assignedMio: string;
  status: "Active" | "Inactive";
  email?: string;
  keyProducts?: string[];
  lastVisited?: string;
  monthlyRevenueEst?: string;
  visitFrequency?: string;
}

