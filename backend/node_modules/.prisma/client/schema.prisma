generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id                    String   @id @default(uuid())
  doctorName            String
  phone                 String
  bmdcRegNumber         String   @unique
  specialtyAndInstitute String
  chamber               String
  territoryAndMio       String
  email                 String?
  tier                  String
  patientVolumeDaily    Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
  PROBATION
  ON_LEAVE
}

enum PaymentStatus {
  PENDING
  PAID
  PROCESSING
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  staff       Staff[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Staff {
  id          String      @id @default(uuid())
  empId       String      @unique
  fullName    String
  phone       String
  email       String?
  nidNumber   String?
  fathersName String?
  mothersName String?
  address     String?
  department  String?
  territory   String?
  supervisor  String? // <--- Added supervisor field
  status      StaffStatus @default(ACTIVE)
  joiningDate DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  roleId   String?
  role     Role?    @relation(fields: [roleId], references: [id])
  salaries Salary[]
}

model Salary {
  id               String        @id @default(uuid())
  staffId          String
  staff            Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  payPeriod        String        @default("September 2026")
  baseSalary       Decimal       @db.Decimal(10, 2)
  houseRent        Decimal       @default(0.00) @db.Decimal(10, 2)
  medicalAllowance Decimal       @default(0.00) @db.Decimal(10, 2)
  conveyanceTaDa   Decimal       @default(0.00) @db.Decimal(10, 2)
  salesIncentive   Decimal       @default(0.00) @db.Decimal(10, 2)
  specialBonus     Decimal       @default(0.00) @db.Decimal(10, 2)
  providentFund    Decimal       @default(0.00) @db.Decimal(10, 2)
  taxDeduction     Decimal       @default(0.00) @db.Decimal(10, 2)
  otherDeductions  Decimal       @default(0.00) @db.Decimal(10, 2)
  leaveDays        Int           @default(0) // <--- Track days off / leave here
  netPay           Decimal       @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(PENDING)
  effectiveDate    DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([staffId, payPeriod])
}
