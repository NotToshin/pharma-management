generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id                    String   @id @default(uuid())
  doctorName            String
  phone                 String
  bmdcRegNumber         String   @unique
  specialtyAndInstitute String
  chamber               String
  territoryAndMio       String
  email                 String?
  tier                  String
  patientVolumeDaily    Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
  PROBATION
  ON_LEAVE
}

enum PaymentStatus {
  PENDING
  PAID
  PROCESSING
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  staff       Staff[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Staff {
  id          String      @id @default(uuid())
  empId       String      @unique
  fullName    String
  phone       String
  email       String?
  nidNumber   String?
  fathersName String?
  mothersName String?
  address     String?
  department  String?
  territory   String?
  supervisor  String? // <--- Added supervisor field
  status      StaffStatus @default(ACTIVE)
  joiningDate DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  roleId   String?
  role     Role?    @relation(fields: [roleId], references: [id])
  salaries Salary[]
}

model Salary {
  id               String        @id @default(uuid())
  staffId          String
  staff            Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  payPeriod        String        @default("September 2026")
  baseSalary       Decimal       @db.Decimal(10, 2)
  houseRent        Decimal       @default(0.00) @db.Decimal(10, 2)
  medicalAllowance Decimal       @default(0.00) @db.Decimal(10, 2)
  conveyanceTaDa   Decimal       @default(0.00) @db.Decimal(10, 2)
  salesIncentive   Decimal       @default(0.00) @db.Decimal(10, 2)
  specialBonus     Decimal       @default(0.00) @db.Decimal(10, 2)
  providentFund    Decimal       @default(0.00) @db.Decimal(10, 2)
  taxDeduction     Decimal       @default(0.00) @db.Decimal(10, 2)
  otherDeductions  Decimal       @default(0.00) @db.Decimal(10, 2)
  leaveDays        Int           @default(0) // <--- Track days off / leave here
  netPay           Decimal       @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(PENDING)
  effectiveDate    DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([staffId, payPeriod])
}

model Client {
  id                    String   @id @default(uuid())
  clientCode            String   @unique
  pharmacyName          String
  proprietor            String?
  phone                 String
  drugLicenseNo         String?
  tradeLicenseNo        String?
  address               String?
  territory             String?
  assignedMio           String?
  creditLimitBDT        Decimal  @default(150000) @db.Decimal(12, 2)
  outstandingBalanceBDT Decimal  @default(0.00) @db.Decimal(12, 2)
  creditTermDays        Int      @default(30)
  status                String   @default("Active / Healthy")
  lastBilledDate        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Order {
  id             String   @id @default(uuid())
  orderNumber    String   @unique
  orderDate      String
  pharmacyName   String
  territory      String
  assignedMio    String
  itemsSummary   String
  itemsDetail    Json? // <-- Stores the exact array of items [{ no, description, quantity, unitCost, total }]
  totalBoxes     Int
  orderValue     Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0.00) @db.Decimal(12, 2)
  comments       String?
  deliveryMethod String
  status         String
  challanNumber  String?
  invoiceNumber  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TreasuryDeposit {
  id              String   @id @default(uuid())
  destinationType String // "Cash Drawer" or "Bank Account"
  destinationName String // e.g. "Head Office Cash Safe" or "Eastern Bank PLC"
  amount          Decimal  @db.Decimal(12, 2)
  salesRep        String?
  discrepancy     Decimal  @default(0.00) @db.Decimal(12, 2)
  resolution      String?
  createdAt       DateTime @default(now())
}

model ExpenseVoucher {
  id            String   @id @default(uuid())
  voucherNo     String   @unique
  payeeName     String
  category      String
  fundingSource String // "Cash Safe" or "Bank Account"
  sourceDetail  String // e.g. "Head Office Cash Safe" or "Eastern Bank PLC"
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum AccountCategory {
  BANK
  CASH
}

enum JournalFlowType {
  INFLOW // Deposits, Capital, Sales Collection
  OUTFLOW // Withdrawals, Expense Payments
  TRANSFER // Cash-to-Bank, Bank-to-Cash, Bank-to-Bank
  LOAN // Bank Loans, Director/Investor Borrowings
}

model FinancialAccount {
  id            String          @id @default(uuid())
  accountTitle  String          @unique
  category      AccountCategory // BANK or CASH
  institution   String // e.g., "Eastern Bank PLC" or "Main Cash Drawer"
  accountNumber String // Account # or "CASH-HQ-01"
  branch        String // e.g., "Gulshan Corporate" or "Mirpur HQ"
  accountClass  String // "Current", "Savings", "Petty Cash", "Escrow", "Cash Counter"
  balance       Decimal         @default(0.00) @db.Decimal(14, 2)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  debitEntries  JournalTransaction[] @relation("SourceAccount")
  creditEntries JournalTransaction[] @relation("DestinationAccount")
}

model JournalTransaction {
  id                   String          @id @default(uuid())
  entryDate            String
  refCode              String          @unique
  flowType             JournalFlowType
  particulars          String
  fundingEntity        String? // e.g., "Loan from DBBL", "Director Equity", "Chemist Cash"
  method               String // "Cash Handover", "BEFTN / RTGS", "Cheque Deposit", "ATM"
  amount               Decimal         @db.Decimal(14, 2)
  reconciliationStatus String          @default("Reconciled")

  sourceAccountId String?
  sourceAccount   FinancialAccount? @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)

  destinationAccountId String?
  destinationAccount   FinancialAccount? @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
