generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
    url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Embedded composite types
// ─────────────────────────────────────────────

type OrderItem {
  no          Int
  description String
  quantity    Int
  unitCost    Float
  total       Float
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
  PROBATION
  ON_LEAVE
}

enum PaymentStatus {
  PENDING
  PAID
  PROCESSING
}

enum AccountCategory {
  BANK
  CASH
}

enum JournalFlowType {
  INFLOW   // Deposits, Capital, Sales Collection
  OUTFLOW  // Withdrawals, Expense Payments
  TRANSFER // Cash-to-Bank, Bank-to-Cash, Bank-to-Bank
  LOAN     // Bank Loans, Director/Investor Borrowings
}

// ─────────────────────────────────────────────
// Doctors
// ─────────────────────────────────────────────

model Doctor {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  doctorName            String
  phone                 String
  bmdcRegNumber         String   @unique
  specialtyAndInstitute String
  chamber               String
  territoryAndMio       String
  email                 String
  tier                  String
  patientVolumeDaily    Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ─────────────────────────────────────────────
// HR / Staff
// ─────────────────────────────────────────────

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  permissions String[]
  staff       Staff[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Staff {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  empId       String      @unique
  fullName    String
  phone       String
  email       String?
  nidNumber   String?
  fathersName String?
  mothersName String?
  address     String?
  department  String?
  territory   String?
  supervisor  String?
  status      StaffStatus @default(ACTIVE)
  joiningDate DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  roleId   String? @db.ObjectId
  role     Role?   @relation(fields: [roleId], references: [id])
  salaries Salary[]
}

model Salary {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  staffId          String        @db.ObjectId
  staff            Staff         @relation(fields: [staffId], references: [id])
  payPeriod        String        @default("September 2026")
  baseSalary       Float  
  houseRent        Float         @default(0.00)
  medicalAllowance Float         @default(0.00)
  conveyanceTaDa   Float         @default(0.00)
  salesIncentive   Float         @default(0.00)
  specialBonus     Float         @default(0.00)
  providentFund    Float         @default(0.00)
  taxDeduction     Float         @default(0.00)
  otherDeductions  Float         @default(0.00)
  leaveDays        Int           @default(0) // Track days off / leave here
  netPay           Float  
  paymentStatus    PaymentStatus @default(PENDING)
  effectiveDate    DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([staffId, payPeriod])
}

// ─────────────────────────────────────────────
// Clients & Orders
// ─────────────────────────────────────────────

model Client {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  clientCode            String   @unique
  pharmacyName          String
  proprietor            String?
  phone                 String
  drugLicenseNo         String?
  tradeLicenseNo        String?
  address               String?
  territory             String?
  assignedMio           String?
  creditLimitBDT        Float    @default(150000)
  outstandingBalanceBDT Float    @default(0.00)
  creditTermDays        Int      @default(30)
  status                String   @default("Active / Healthy")
  lastBilledDate        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Order {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber    String      @unique
  orderDate      String
  pharmacyName   String
  territory      String
  assignedMio    String
  itemsSummary   String
  itemsDetail    OrderItem[] // Embedded line items (was Json)
  totalBoxes     Int
  orderValue     Float  
  discount       Float       @default(0.00)
  comments       String?
  deliveryMethod String
  status         String
  challanNumber  String?
  invoiceNumber  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ─────────────────────────────────────────────
// Finance
// ─────────────────────────────────────────────

model TreasuryDeposit {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  destinationType String   // "Cash Drawer" or "Bank Account"
  destinationName String   // e.g. "Head Office Cash Safe" or "Eastern Bank PLC"
  amount          Float  
  salesRep        String?
  discrepancy     Float    @default(0.00)
  resolution      String?
  createdAt       DateTime @default(now())
}

model ExpenseVoucher {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  voucherNo     String   @unique
  payeeName     String
  category      String
  fundingSource String   // "Cash Safe" or "Bank Account"
  sourceDetail  String   // e.g. "Head Office Cash Safe" or "Eastern Bank PLC"
  amount        Float  
  paymentDate   String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FinancialAccount {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  accountTitle  String          @unique
  category      AccountCategory // BANK or CASH
  institution   String          // e.g., "Eastern Bank PLC" or "Main Cash Drawer"
  accountNumber String          // Account # or "CASH-HQ-01"
  branch        String          // e.g., "Gulshan Corporate" or "Mirpur HQ"
  accountClass  String          // "Current", "Savings", "Petty Cash", "Escrow", "Cash Counter"
  balance       Float           @default(0.00)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  debitEntries  JournalTransaction[] @relation("SourceAccount")
  creditEntries JournalTransaction[] @relation("DestinationAccount")
}

model JournalTransaction {
  id                   String          @id @default(auto()) @map("_id") @db.ObjectId
  entryDate            String
  refCode              String          @unique
  flowType             JournalFlowType
  particulars          String
  fundingEntity        String?         // e.g., "Loan from DBBL", "Director Equity", "Chemist Cash"
  method               String          // "Cash Handover", "BEFTN / RTGS", "Cheque Deposit", "ATM"
  amount               Float  
  reconciliationStatus String          @default("Reconciled")

  sourceAccountId String?           @db.ObjectId
  sourceAccount   FinancialAccount? @relation("SourceAccount", fields: [sourceAccountId], references: [id])

  destinationAccountId String?           @db.ObjectId
  destinationAccount   FinancialAccount? @relation("DestinationAccount", fields: [destinationAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Inventory
// ─────────────────────────────────────────────

model InventoryBatch {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  skuCode          String   @unique
  brandName        String
  genericName      String
  category         String
  batchNumber      String   @unique
  mfgDate          String
  expiryDate       String
  availableUnits   Int
  unitPrice        Float  
  warehouseBin     String
  storageCondition String   // "Controlled Ambient (<25°C)" | "Cold Chain (2-8°C)"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─────────────────────────────────────────────
// System access control
// ─────────────────────────────────────────────

model SystemRole {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  code            String   @unique
  description     String
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users       SystemUser[]
  permissions RolePermission[]
}

model RolePermission {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  roleId         String     @db.ObjectId
  role           SystemRole @relation(fields: [roleId], references: [id])
  module         String     // e.g. "Doctor Registry", "FEFO Stock Control"
  category       String     // "Clinical", "Warehouse", "Logistics", "Finance", "HR"
  read           Boolean    @default(false)
  create         Boolean    @default(false)
  edit           Boolean    @default(false)
  delete         Boolean    @default(false)
  specialAction  String?    // e.g. "Override Credit Hold"
  specialGranted Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, module])
}

model SystemUser {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String     @unique
  passwordHash     String
  refreshTokenHash String?
  territory        String     @default("Dhaka HQ")
  status       String     @default("Active") // "Active" | "Restricted"
  lastLogin    String     @default("Never logged in")
  roleId       String     @db.ObjectId
  role         SystemRole @relation(fields: [roleId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
